{
  "compilerOptions": {
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["vitest/globals"]
  },
  "include": ["vite.config.ts", "scripts/**/*.ts"],
  "exclude": ["scripts/**/*.test.ts"]
}
