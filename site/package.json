{
  "name": "@openwdl/site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:content && vite --config vite.config.ts",
    "build:content": "tsx scripts/generate-docs.ts && tsx scripts/generate-blog-routes.ts",
    "build:client": "vite build --config vite.config.ts",
    "build:ssr": "vite build --config vite.config.ts --ssr src/entry-server.tsx --outDir dist-server",
    "build:prerender": "tsx scripts/prerender.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/copy-assets.mjs && npm run build:content && npm run typecheck:scripts && tsc -b && npm run build:client && npm run build:ssr && npm run build:prerender",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:static": "vitest run --config vitest.static.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@openwdl/ui": "git+https://github.com/openwdl/ui.git#v1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.5.0",
    "eslint-plugin-jsdoc": "^63.0.7",
    "globals": "^17.6.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
